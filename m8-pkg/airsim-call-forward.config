# Call forwarding: every ringing / answered / ended call is POSTed to one URL.
# Enable with:  uci set airsim-call-forward.forward.enabled='1'
#               uci set airsim-call-forward.forward.url='https://...'
#               uci commit airsim-call-forward
config forward 'forward'
	option enabled '0'
	option url ''
	option method 'POST'
	option content_type 'application/json'
	option timeout '10'
	option poll '2'
	option notify_ringing '1'
	option notify_answered '0'
	option notify_ended '1'
	option notify_missed '1'
	option body '{"event":"{event}","number":"{number}","state":"{state}","time":"{time}","device":"{device}"}'
