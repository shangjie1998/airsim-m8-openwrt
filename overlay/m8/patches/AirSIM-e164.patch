+
+// normalizeSelfNumber renders the SIM's own number in E.164 so clients can
+// display and dial it without guessing the country code. Some SIMs store the
+// number as "8613..." with no leading "+", which made the app show a bare
+// country-code prefix instead of a dialable number.
+func normalizeSelfNumber(raw string) string {
+	n := strings.TrimSpace(raw)
+	if n == "" {
+		return ""
+	}
+	if strings.HasPrefix(n, "+") {
+		return n
+	}
+	if strings.HasPrefix(n, "00") {
+		return "+" + strings.TrimPrefix(n, "00")
+	}
+	// China: 86 + 11-digit mobile subscriber number.
+	if len(n) == 13 && strings.HasPrefix(n, "86") {
+		return "+" + n
+	}
+	return n
+}
