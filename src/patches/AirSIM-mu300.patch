+	"testing"
+	"time"
+)
+
+func TestMU300ProfileIsolation(t *testing.T) {
+	p := runtimeProfileFrom("mu300-openwrt")
+	if !p.CallAudio || !p.RequiresModem || p.AndroidTelecom || p.WRTLite || p.NetworkPolicyNative {
+		t.Fatalf("unsafe MU300 capabilities: %+v", p)
+	}
+	get := func(k string) string {
+		return map[string]string{runtimeProfileEnvironment: "mu300-openwrt", "AIRSIM_VOICE_BACKEND": "mu300"}[k]
+	}
+	b, e := loadVoiceBackend(get)
+	if e != nil || b.endpoint != "127.0.0.1:7580" || b.requiresLocalRuntime() {
+		t.Fatalf("%+v %v", b, e)
+	}
+	_, e = loadVoiceBackend(func(k string) string {
+		if k == "AIRSIM_VOICE_BACKEND" {
+			return "mu300"
+		}
+		return "android-avf"
+	})
+	if e == nil {
+		t.Fatal("MU300 accepted on Android profile")
+	}
+}
+func TestMU300EndpointRejectsLAN(t *testing.T) {
+	_, e := loadVoiceBackend(func(k string) string {
+		return map[string]string{runtimeProfileEnvironment: "mu300-openwrt", "AIRSIM_VOICE_BACKEND": "mu300", "AIRSIM_MU300_PCM_ADDRESS": "192.168.78.1:7580"}[k]
+	})
+	if e == nil {
+		t.Fatal("LAN raw PCM accepted")
+	}
+}
+func TestMU300DialLogRedaction(t *testing.T) {
+	if safeMU300Verb("ATD123456789;") != "ATD" {
+		t.Fatal("dial number in log")
+	}
+}
+
+func TestMU300NumberRefreshClearsStaleSIMMetadata(t *testing.T) {
+	response := "+CNUM: \"\",\"15550001111\",145\nOK"
+	var failure error
+	a := testMU300Calls(t, func(command string, _ time.Duration) (string, error) {
+		if command != "AT+CNUM" {
+			t.Fatal("unexpected identity command", command)
+		}
+		return response, failure
+	})
+	if number, err := a.mu300RefreshNumber(); err != nil || number != "15550001111" || a.modem.PhoneNumberStatus != "available" {
+		t.Fatal("SIM number not loaded", err)
+	}
+	response = "OK"
+	if number, err := a.mu300RefreshNumber(); err != nil || number != "" || a.modem.PhoneNumber != "" || a.modem.PhoneNumberStatus != "not_provided" {
+		t.Fatal("old SIM number retained")
+	}
+	failure = errors.New("SIM unavailable")
+	if _, err := a.mu300RefreshNumber(); err == nil || a.modem.PhoneNumberStatus != "unavailable" || a.modem.PhoneNumberUpdatedAt == "" {
+		t.Fatal("read failure not represented")
+	}
+}
+
+func testMU300Calls(t *testing.T, command func(string, time.Duration) (string, error)) *agent {
+	return &agent{mu300Operations: &mu300OperationStore{directory: t.TempDir()}, profile: runtimeProfileFrom("mu300-openwrt"), push: newPushManager(filepath.Join(t.TempDir(), "push.json")), voiceBackend: voiceBackendConfig{kind: voiceBackendMU300, endpoint: "127.0.0.1:7580"}, callControlCommand: command, callControlSleep: func(time.Duration) {}, mu300DialWindow: 50 * time.Millisecond}
+}
+
+func TestMU300DialReceiptAndIdempotency(t *testing.T) {
+	state := "OK"
+	dials := 0
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		if cmd == "AT+CLCC" {
+			return state, nil
+		}
+		if cmd == "ATD12345;" {
+			dials++
+			state = `+CLCC: 1,0,2,0,0,"12345",129` + "\nOK"
+			return "OK", nil
+		}
+		return "", errors.New("unexpected command")
+	})
+	first, err := a.mu300Dial("12345", "operation-1", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first["operation_id"] != "operation-1" || first["android_id"] == "" || first["android_id"] != first["backend_id"] {
+		t.Fatalf("invalid receipt: %v", first)
+	}
+	if a.calls.Active.AndroidID != first["android_id"] {
+		t.Fatal("receipt and call events disagree")
+	}
+	second, err := a.mu300Dial("12345", "operation-1", "")
+	if err != nil || second["backend_id"] != first["backend_id"] || dials != 1 {
+		t.Fatal("replayed operation redialed")
+	}
+	if _, err = a.mu300Dial("54321", "operation-1", ""); err == nil {
+		t.Fatal("operation reused for another number")
+	}
+	if _, err = a.mu300Dial("54321", "operation-2", ""); err == nil || dials != 1 {
+		t.Fatal("second call admitted")
+	}
+}
+
+func TestMU300IncomingAnswerAndStaleHangup(t *testing.T) {
+	state := `+CLCC: 1,1,4,0,0,"12345",129` + "\nOK"
+	answers, hangups := 0, 0
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		switch cmd {
+		case "AT+CLCC":
+			return state, nil
+		case "ATA":
+			answers++
+			state = `+CLCC: 1,1,0,0,0,"12345",129` + "\nOK"
+			return "OK", nil
+		case "AT+CHUP":
+			hangups++
+			state = "OK"
+			return "OK", nil
+		}
+		return "", errors.New("unexpected command")
+	})
+	if _, err := a.mu300RefreshCalls(); err != nil {
+		t.Fatal(err)
+	}
+	oldID := a.calls.Active.ID
+	if err := a.answerCallForID(oldID); err != nil || answers != 1 || a.calls.Active.State != "active" || a.calls.Active.AndroidID != oldID {
+		t.Fatal("incoming call not answered with stable identity", err)
+	}
+	if err := a.hangupCallForID(oldID); err != nil || hangups != 1 || a.calls.Active != nil {
+		t.Fatal("hangup failed", err)
+	}
+	// A different caller reuses the modem's numeric slot; identity must not.
+	state = `+CLCC: 1,1,4,0,0,"54321",129` + "\nOK"
+	if _, err := a.mu300RefreshCalls(); err != nil {
+		t.Fatal(err)
+	}
+	if a.calls.Active.ID == oldID {
+		t.Fatal("reused canonical call identity")
+	}
+	if err := a.hangupCallForID(oldID); err == nil || hangups != 1 {
+		t.Fatal("stale hangup reached replacement call")
+	}
+	if err := a.answerCallForID(oldID); err == nil || answers != 1 {
+		t.Fatal("stale answer reached replacement call")
+	}
+}
+
+func TestMU300UncertainATDNeverRetries(t *testing.T) {
+	dials := 0
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		if strings.HasPrefix(cmd, "ATD") {
+			dials++
+			return "", errors.New("timeout")
+		}
+		return "OK", nil
+	})
+	if _, err := a.mu300Dial("12345", "uncertain", ""); err == nil {
+		t.Fatal("unconfirmed dial accepted")
+	}
+	if _, err := a.mu300Dial("12345", "uncertain", ""); err == nil || dials != 1 {
+		t.Fatal("uncertain operation repeated ATD")
+	}
+}
+
+func TestMU300DialConfirmsAfterSlowATChannel(t *testing.T) {
+	failures, dialed := 3, false
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		switch {
+		case strings.HasPrefix(cmd, "ATD"):
+			dialed = true
+			return "OK", nil
+		case cmd == "AT+CLCC":
+			if !dialed {
+				return "OK", nil
+			}
+			if failures > 0 {
+				failures--
+				return "", errors.New("mu300-at: busy")
+			}
+			return "+CLCC: 1,0,3,0,0,\"\",129\nOK", nil
+		}
+		return "", errors.New("unexpected command")
+	})
+	receipt, err := a.mu300Dial("13800138000", "operation-slow", "")
+	if err != nil {
+		t.Fatalf("a busy AT channel turned a placed call into a failure: %v", err)
+	}
+	if receipt["android_id"] == "" || receipt["android_id"] != receipt["backend_id"] {
+		t.Fatalf("invalid receipt: %v", receipt)
+	}
+}
+
+func TestMU300DialAcceptsNetworkRewrittenNumber(t *testing.T) {
+	dialed := false
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		switch {
+		case strings.HasPrefix(cmd, "ATD13800138000;"):
+			dialed = true
+			return "OK", nil
+		case cmd == "AT+CLCC":
+			if dialed {
+				return "+CLCC: 1,0,3,0,0,\"+8613800138000\",145\nOK", nil
+			}
+			return "OK", nil
+		}
+		return "", errors.New("unexpected command")
+	})
+	if _, err := a.mu300Dial("13800138000", "operation-rewrite", ""); err != nil {
+		t.Fatalf("network-rewritten number rejected: %v", err)
+	}
+}
+
+func TestMU300SetupGapKeepsCallIdentity(t *testing.T) {
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		if cmd == "AT+CLCC" {
+			return "+CLCC: 1,0,2,0,0,\"13800138000\",129\nOK", nil
+		}
+		return "", errors.New("unexpected command")
+	})
+	if _, err := a.mu300RefreshCalls(); err != nil {
+		t.Fatal(err)
+	}
+	id := a.calls.Active.ID
+	base := time.Now()
+	// The modem does not list an outgoing call for a few seconds between
+	// dialing and alerting. The identity has to survive that gap.
+	a.mu300ApplyCallPoll(nil, base.Add(time.Second), true)
+	a.mu300ApplyCallPoll(nil, base.Add(5*time.Second), true)
+	if a.calls.Active == nil || a.calls.Active.ID != id || len(a.calls.History) != 0 {
+		t.Fatal("the setup gap ended the call")
+	}
+	a.mu300ApplyCallPoll([]parsedCall{{Index: 1, Direction: "outgoing", State: "alerting", Number: "13800138000"}}, base.Add(7*time.Second), true)
+	if a.calls.Active == nil || a.calls.Active.ID != id || a.calls.Active.State != "alerting" {
+		t.Fatal("the call came back with a new identity")
+	}
+	a.mu300ApplyCallPoll(nil, base.Add(8*time.Second), true)
+	if a.calls.Active == nil || a.calls.Active.ID != id {
+		t.Fatal("one empty snapshot ended an alerting call")
+	}
+	a.mu300ApplyCallPoll(nil, base.Add(19*time.Second), true)
+	if a.calls.Active != nil || len(a.calls.History) != 1 || a.calls.History[0].ID != id {
+		t.Fatal("a confirmed hangup was not reported")
+	}
+}
diff --git a/module/module-agent/mu300_urc.go b/module/module-agent/mu300_urc.go
new file mode 100644
index 0000000..653f3c3
--- /dev/null
+++ b/module/module-agent/mu300_urc.go
@@ -0,0 +1,226 @@
+package main
+
+import (
+	"bytes"
+	"io"
+	"log"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Read the existing AT owner's capped log, never its tty. The cursor is used
+// only under mu300CallMu. Startup/rotation/truncation discard backlog; partial
+// lines and SMS contents are never exposed as diagnostics or retained events.
+type mu300URCTail struct {
+	path          string
+	file          os.FileInfo
+	offset        int64
+	anchor        []byte
+	skipPartial   bool
+	pending       map[string]mu300PendingTerminal
+	earlySequence uint64
+	earlyOn       bool
+}
+
+type mu300TerminalHint struct {
+	slot      int
+	direction string
+	ended     bool
+}
+
+type mu300PendingTerminal struct {
+	slot int
+	at   time.Time
+}
+
+const mu300TerminalHintLifetime = 5 * time.Second
+
+func (t *mu300URCTail) reset(f *os.File, info os.FileInfo) {
+	t.pending = nil
+	t.earlySequence++
+	t.earlyOn = false
+	t.file, t.offset = info, info.Size()
+	t.anchor = make([]byte, min(uint64(32), uint64(t.offset)))
+	if len(t.anchor) > 0 {
+		_, _ = f.ReadAt(t.anchor, t.offset-int64(len(t.anchor)))
+	}
+	t.skipPartial = len(t.anchor) > 0 && t.anchor[len(t.anchor)-1] != '\n'
+}
+
+func (t *mu300URCTail) read() []mu300TerminalHint {
+	info, err := os.Lstat(t.path)
+	if err != nil || !info.Mode().IsRegular() {
+		t.file = nil
+		t.pending = nil
+		t.earlySequence++
+		t.earlyOn = false
+		return nil
+	}
+	f, err := os.Open(t.path)
+	if err != nil {
+		t.pending = nil
+		t.earlySequence++
+		t.earlyOn = false
+		return nil
+	}
+	defer f.Close()
+	actual, err := f.Stat()
+	if err != nil || !os.SameFile(info, actual) {
+		t.file = nil
+		t.pending = nil
+		t.earlySequence++
+		t.earlyOn = false
+		return nil
+	}
+	if t.file == nil || !os.SameFile(t.file, actual) || actual.Size() < t.offset || actual.Size()-t.offset > 65536 {
+		t.reset(f, actual)
+		return nil
+	}
+	anchor := make([]byte, len(t.anchor))
+	if len(anchor) > 0 {
+		if _, err = f.ReadAt(anchor, t.offset-int64(len(anchor))); err != nil || !bytes.Equal(anchor, t.anchor) {
+			t.reset(f, actual)
+			return nil
+		}
+	}
+	data, err := io.ReadAll(io.NewSectionReader(f, t.offset, actual.Size()-t.offset))
+	if err != nil {
+		t.pending = nil
+		t.earlySequence++
+		t.earlyOn = false
+		return nil
+	}
+	end := bytes.LastIndexByte(data, '\n') + 1
+	if end == 0 {
+		return nil
+	}
+	complete := data[:end]
+	if t.skipPartial {
+		complete = complete[bytes.IndexByte(complete, '\n')+1:]
+		t.skipPartial = false
+	}
+	// A later progress event for the same slot supersedes an earlier terminal
+	// line in this batch. We do not interpret progress as a live call: CLCC does.
+	last := map[int]mu300TerminalHint{}
+	malformed := false
+	for _, line := range strings.Split(string(complete), "\n") {
+		if strings.HasPrefix(strings.TrimSpace(line), "+EARLYMEDIA:") {
+			t.earlySequence++
+			t.earlyOn = strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(line), "+EARLYMEDIA:")) == "1"
+			continue
+		}
+		slot, direction, ended, ok := parseMU300TerminalDSCI(line)
+		if !ok {
+			if strings.HasPrefix(strings.TrimSpace(line), "^DSCI:") {
+				malformed = true
+			}
+			continue
+		}
+		last[slot] = mu300TerminalHint{slot: slot, direction: direction, ended: ended}
+	}
+	t.offset += int64(end)
+	t.anchor = make([]byte, min(uint64(32), uint64(t.offset)))
+	if len(t.anchor) > 0 {
+		_, _ = f.ReadAt(t.anchor, t.offset-int64(len(t.anchor)))
+	}
+	var hints []mu300TerminalHint
+	if malformed {
+		t.pending = nil
+		t.earlySequence++
+		t.earlyOn = false
+		return nil
+	}
+	for _, hint := range last {
+		hints = append(hints, hint)
+	}
+	return hints
+}
+
+func parseMU300TerminalDSCI(line string) (slot int, direction string, ended, ok bool) {
+	line = strings.TrimSpace(line)
+	if !strings.HasPrefix(line, "^DSCI:") {
+		return
+	}
+	// Only inspect the four numeric fields. Remaining fields may contain a
+	// phone number and are neither retained nor passed to the generic parser.
+	parts := strings.SplitN(strings.TrimPrefix(line, "^DSCI:"), ",", 5)
+	if len(parts) < 4 {
+		return
+	}
+	var values [4]int
+	for i := range values {
+		n, err := strconv.Atoi(strings.TrimSpace(parts[i]))
+		if err != nil {
+			return 0, "", false, false
+		}
+		values[i] = n
+	}
+	if values[0] < 1 || values[0] > 7 || values[1] < 0 || values[1] > 1 || values[2] < 0 || values[2] > 7 {
+		return
+	}
+	// The verified U30 reports mode 1 (and 3 during setup), unlike the generic
+	// Agent's DSCI parser. A terminal hint still requires a matching cached UUID
+	// and a fresh successful CLCC snapshot in which that slot is absent.
+	if values[3] != 0 && values[3] != 1 && values[3] != 3 {
+		return
+	}
+	direction = "outgoing"
+	if values[1] == 1 {
+		direction = "incoming"
+	}
+	return values[0], direction, values[2] == 6, true
+}
+
+// Keep a fresh end hint bound to the current UUID for a few polls. The native
+// daemon can log termination before CLCC drops the slot. A progress event,
+// changed UUID, log discontinuity or expiry invalidates it; a live CLCC row
+// always wins. Never apply a hint directly as a hangup command.
+func (a *agent) mu300FreshTerminalHints() map[string]bool {
+	return a.mu300TerminalHintsAt(time.Now())
+}
+func (a *agent) mu300TerminalHintsAt(now time.Time) map[string]bool {
+	if a.mu300URC == nil {
+		return nil
+	}
+	tail := a.mu300URC
+	hints := tail.read()
+	if tail.pending == nil {
+		tail.pending = map[string]mu300PendingTerminal{}
+	}
+	ended := map[string]bool{}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.mu300EarlySequence != tail.earlySequence {
+		a.mu300EarlySequence = tail.earlySequence
+		a.mu300EarlyCall = ""
+		if tail.earlyOn && len(a.mu300Calls) == 1 {
+			for _, c := range a.mu300Calls {
+				if c.Direction == "outgoing" && (c.State == "dialing" || c.State == "alerting") {
+					a.mu300EarlyCall = c.ID
+				}
+			}
+		}
+	}
+	for _, hint := range hints {
+		for id, old := range tail.pending {
+			if old.slot == hint.slot {
+				delete(tail.pending, id)
+			}
+		}
+		if c, ok := a.mu300Calls[hint.slot]; hint.ended && ok && c.Direction == hint.direction {
+			tail.pending[c.ID] = mu300PendingTerminal{slot: hint.slot, at: now}
+			log.Print("MU300 call: native termination observed")
+		}
+	}
+	for id, hint := range tail.pending {
+		c, ok := a.mu300Calls[hint.slot]
+		if !ok || c.ID != id || now.Sub(hint.at) < 0 || now.Sub(hint.at) > mu300TerminalHintLifetime {
+			delete(tail.pending, id)
+			continue
+		}
+		ended[id] = true
+	}
+	return ended
+}
