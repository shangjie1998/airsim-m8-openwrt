+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func batteryFixture(t *testing.T, root, name, value string) {
+	t.Helper()
+	p := filepath.Join(root, name)
+	if err := os.MkdirAll(filepath.Dir(p), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte(value), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func u30BatteryFixture(t *testing.T) string {
+	t.Helper()
+	root := t.TempDir()
+	for name, value := range map[string]string{
+		"etc/mu300-device":                        "u30air\n",
+		"sys/class/power_supply/battery/type":     "Battery\n",
+		"sys/class/power_supply/battery/present":  "1\n",
+		"sys/class/power_supply/battery/capacity": "82\n",
+		"sys/class/power_supply/battery/status":   "Charging\n",
+	} {
+		batteryFixture(t, root, name, value)
+	}
+	return root
+}
+
+func TestMU300BatteryNativeStatesAndZero(t *testing.T) {
+	now := time.UnixMilli(1800000000000)
+	for _, tc := range []struct {
+		status, capacity string
+		percent          int
+		charging         bool
+	}{
+		{"Charging", "0", 0, true},
+		{"Full", "100", 100, true},
+		{"Discharging", "82", 82, false},
+		{"Not charging", "82", 82, false},
+	} {
+		t.Run(tc.status, func(t *testing.T) {
+			root := u30BatteryFixture(t)
+			batteryFixture(t, root, "sys/class/power_supply/battery/status", tc.status)
+			batteryFixture(t, root, "sys/class/power_supply/battery/capacity", tc.capacity)
+			v := readMU300Battery(root, now)
+			if v == nil || v.Percent != tc.percent || v.Charging != tc.charging || v.ObservedAtMS != now.UnixMilli() {
+				t.Fatalf("unexpected battery: %+v", v)
+			}
+		})
+	}
+}
+
+func TestMU300BatteryRejectsUnknownAndSyntheticReadings(t *testing.T) {
+	for _, tc := range []struct{ name, path, value string }{
+		{"f50", "etc/mu300-device", "f50"},
+		{"v50", "etc/mu300-device", "v50"},
+		{"unknown board", "etc/mu300-device", ""},
+		{"charger", "sys/class/power_supply/battery/type", "USB"},
+		{"absent", "sys/class/power_supply/battery/present", "0"},
+		{"invalid present", "sys/class/power_supply/battery/present", "unknown"},
+		{"unknown status", "sys/class/power_supply/battery/status", "Unknown"},
+		{"missing capacity", "sys/class/power_supply/battery/capacity", ""},
+		{"fraction", "sys/class/power_supply/battery/capacity", "82.5"},
+		{"negative", "sys/class/power_supply/battery/capacity", "-1"},
+		{"raw gauge tenths", "sys/class/power_supply/battery/capacity", "820"},
+		{"overfull", "sys/class/power_supply/battery/capacity", "101"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			root := u30BatteryFixture(t)
+			batteryFixture(t, root, tc.path, tc.value)
+			if v := readMU300Battery(root, time.Now()); v != nil {
+				t.Fatalf("invented battery: %+v", v)
+			}
+		})
+	}
+	if v := readMU300Battery(t.TempDir(), time.Now()); v != nil {
+		t.Fatal("missing hardware returned battery")
+	}
+}
+
+func TestMU300BatteryDeviceTreeFallbackAndNoStaleCache(t *testing.T) {
+	root := u30BatteryFixture(t)
+	marker := filepath.Join(root, "etc/mu300-device")
+	if err := os.Remove(marker); err != nil {
+		t.Fatal(err)
+	}
+	if v := readMU300Battery(root, time.Now()); v != nil {
+		t.Fatal("unidentified board accepted")
+	}
+	if err := os.MkdirAll(filepath.Join(root, "sys/firmware/devicetree/base/charger_policy_service"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if v := readMU300Battery(root, time.Now()); v == nil {
+		t.Fatal("known U30 tree rejected")
+	}
+	batteryFixture(t, root, "etc/mu300-device", "f50")
+	if v := readMU300Battery(root, time.Now()); v != nil {
+		t.Fatal("explicit other board ignored")
+	}
+	batteryFixture(t, root, "etc/mu300-device", "u30air")
+	if err := os.Remove(filepath.Join(root, "sys/class/power_supply/battery/capacity")); err != nil {
+		t.Fatal(err)
+	}
+	if v := readMU300Battery(root, time.Now()); v != nil {
+		t.Fatal("previous sample retained after read failed")
+	}
+}
+
+func TestMU300BatteryHealthIsProfileScopedAndOptional(t *testing.T) {
+	root := u30BatteryFixture(t)
+	for _, profile := range []string{"mu300-openwrt", "android-avf", "qdc507"} {
+		a := &agent{mu300BatteryRoot: root, profile: runtimeProfile{Name: profile}, at: newATPort("unused"), started: time.Now()}
+		w := httptest.NewRecorder()
+		a.health(w, httptest.NewRequest("GET", "/api/health", nil))
+		var body map[string]json.RawMessage
+		if err := json.Unmarshal(w.Body.Bytes(), &body); err != nil {
+			t.Fatal(err)
+		}
+		if (body["battery"] != nil) != (profile == "mu300-openwrt") {
+			t.Fatal("battery leaked across profiles")
+		}
+	}
+}
+
+func TestMU300BatteryUsesExistingHeartbeatAndCloudPolicy(t *testing.T) {
+	var received []map[string]json.RawMessage
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/v1/events/heartbeat" {
+			t.Error("new battery request channel")
+		}
+		var body map[string]json.RawMessage
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		received = append(received, body)
+		w.WriteHeader(http.StatusAccepted)
+	}))
+	defer server.Close()
+	m := newPushManager(filepath.Join(t.TempDir(), "push.json"))
+	m.client = server.Client()
+	if err := m.store(testPushRegistration(server.URL)); err != nil {
+		t.Fatal(err)
+	}
+	a := &agent{mu300BatteryRoot: u30BatteryFixture(t), profile: runtimeProfile{Name: "mu300-openwrt"}}
+	sample := a.mu300BatterySnapshot()
+	if err := m.sendHeartbeat(agentHeartbeatSnapshot{CellularState: "registered", Battery: sample}); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.sendHeartbeat(agentHeartbeatSnapshot{CellularState: "registered"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.setCloudEnabled(false); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.sendHeartbeat(agentHeartbeatSnapshot{CellularState: "registered", Battery: sample}); err != nil {
+		t.Fatal(err)
+	}
+	if len(received) != 2 {
+		t.Fatal("cloud disabled still transmitted")
+	}
+	var value mu300BatteryReading
+	if err := json.Unmarshal(received[0]["battery"], &value); err != nil {
+		t.Fatal(err)
+	}
+	if value != *sample {
+		t.Fatal("heartbeat changed battery sample")
+	}
+	if _, exists := received[1]["battery"]; exists {
+		t.Fatal("unknown battery fabricated")
+	}
+}
+
+func TestMU300BatteryUnknownUsesObservedChargerStatus(t *testing.T) {
+	for _, tc := range []struct {
+		status, online  string
+		valid, charging bool
+	}{
+		{"Charging", "1", true, true}, {"Full", "1", true, true},
+		{"Not charging", "1", true, false}, {"Discharging", "0", true, false},
+		{"Charging", "0", false, false}, {"Unknown", "1", false, false},
+		{"Charging", "", false, false}, {"Bad", "1", false, false},
+	} {
+		t.Run(tc.status+tc.online, func(t *testing.T) {
+			root := u30BatteryFixture(t)
+			batteryFixture(t, root, "sys/class/power_supply/battery/status", "Unknown")
+			batteryFixture(t, root, "sys/class/power_supply/bq2560x_charger/status", tc.status)
+			batteryFixture(t, root, "sys/class/power_supply/bq2560x_charger/online", tc.online)
+			v := readMU300Battery(root, time.Now())
+			if (v != nil) != tc.valid {
+				t.Fatalf("valid=%v got=%v", tc.valid, v)
+			}
+			if v != nil && (v.Percent != 82 || v.Charging != tc.charging) {
+				t.Fatal("wrong battery source", v)
+			}
+			batteryFixture(t, root, "etc/mu300-device", "f50")
+			if readMU300Battery(root, time.Now()) != nil {
+				t.Fatal("charger fallback escaped U30 profile")
+			}
+		})
+	}
+}
+
+func TestMU300BatteryAuthoritativeBatteryStatusWins(t *testing.T) {
+	root := u30BatteryFixture(t)
+	batteryFixture(t, root, "sys/class/power_supply/battery/status", "Discharging")
+	batteryFixture(t, root, "sys/class/power_supply/bq2560x_charger/status", "Charging")
+	batteryFixture(t, root, "sys/class/power_supply/bq2560x_charger/online", "1")
+	if v := readMU300Battery(root, time.Now()); v == nil || v.Charging {
+		t.Fatal("charger overrode known battery state", v)
+	}
+}
diff --git a/module/module-agent/mu300_calls.go b/module/module-agent/mu300_calls.go
new file mode 100644
index 0000000..91981f9
--- /dev/null
+++ b/module/module-agent/mu300_calls.go
@@ -0,0 +1,445 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"log"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// CLCC indexes are reused by the modem. A UUID belongs to the lifetime of a
+// slot, NOT to whichever call currently wins the legacy Active projection.
+func (a *agent) mu300LiveCallsLocked() []callRecord {
+	var result []callRecord
+	for _, c := range a.mu300Calls {
+		result = append(result, c)
+	}
+	sort.Slice(result, func(i, j int) bool { return result[i].Index < result[j].Index })
+	return result
+}
+
+// A single CLCC snapshot that does not list a live call is not proof that the
+// call ended: the shared AT channel can answer late, truncated or interleaved
+// with another client's request.
+//
+// Keep setup resilient to genuinely missing snapshots. The observed MU300
+// dialing-to-alerting transition uses CLCC mode 3: it must be parsed as voice,
+// not hidden by extending this grace period. A stable alerting row can remain
+// live indefinitely; this budget applies only when a row is actually absent.
+const (
+	mu300CallSetupGrace = 10 * time.Second
+	mu300CallEndGrace   = 4 * time.Second
+)
+
+func mu300EndGraceFor(state string) time.Duration {
+	if state == "dialing" || state == "alerting" {
+		return mu300CallSetupGrace
+	}
+	return mu300CallEndGrace
+}
+
+func (a *agent) mu300ApplyCallPoll(calls []parsedCall, now time.Time, confirmGone bool) {
+	a.mu300ApplyCallPollWithEnd(calls, now, confirmGone, "")
+}
+
+// confirmedEnd is used only after an acknowledged targeted hangup/reject and
+// a fresh snapshot missing that slot. Other missing calls retain their grace.
+func (a *agent) mu300ApplyCallPollWithEnd(calls []parsedCall, now time.Time, confirmGone bool, confirmedEnd string) {
+	a.mu300ApplyCallPollWithEnds(calls, now, confirmGone, map[string]bool{confirmedEnd: true})
+}
+
+func (a *agent) mu300ApplyCallPollWithEnds(calls []parsedCall, now time.Time, confirmGone bool, confirmedEnds map[string]bool) {
+	a.mu.Lock()
+	next := make(map[int]callRecord, len(calls))
+	var changed, ended []callRecord
+	for _, p := range calls {
+		old, exists := a.mu300Calls[p.Index]
+		// A connected slot returning to setup, or changing direction, is a
+		// replacement even if an idle poll was missed. Never reuse its UUID.
+		replaced := exists && (old.Direction != p.Direction ||
+			(old.Number != "" && p.Number != "" && normalizeDialNumber(old.Number) != normalizeDialNumber(p.Number)) ||
+			((old.State == "active" || old.State == "held") &&
+				(p.State == "incoming" || p.State == "waiting" || p.State == "dialing" || p.State == "alerting")))
+		if !exists || replaced {
+			uuid, err := randomUUID()
+			if err != nil {
+				a.calls.LastPollError = "cannot allocate MU300 call identity"
+				a.mu.Unlock()
+				return
+			}
+			old = callRecord{ID: "mu300-" + uuid, AndroidID: "mu300-" + uuid,
+				Index: p.Index, Direction: p.Direction, Number: p.Number, StartedAt: now}
+		}
+		if old.State != p.State || (p.Number != "" && old.Number != p.Number) {
+			old.State, old.UpdatedAt = p.State, now
+			if p.Number != "" {
+				old.Number = p.Number
+			}
+			changed = append(changed, old)
+		}
+		delete(a.mu300GoneSince, old.ID)
+		next[p.Index] = old
+	}
+	for index, old := range a.mu300Calls {
+		if c, exists := next[index]; exists && c.ID == old.ID {
+			continue
+		}
+		if _, exists := next[index]; exists {
+			// The slot now carries another identity: the previous call is over
+			// (redial, direction change, replacement). Never reuse its UUID.
+			delete(a.mu300GoneSince, old.ID)
+			old.EndedAt, old.UpdatedAt = &now, now
+			old.Missed = old.Direction == "incoming" && (old.State == "incoming" || old.State == "waiting")
+			old.State = "ended"
+			ended = append(ended, old)
+			continue
+		}
+		if confirmGone && !confirmedEnds[old.ID] {
+			since, pending := a.mu300GoneSince[old.ID]
+			if !pending {
+				if a.mu300GoneSince == nil {
+					a.mu300GoneSince = make(map[string]time.Time)
+				}
+				a.mu300GoneSince[old.ID] = now
+				next[index] = old
+				continue
+			}
+			if now.Sub(since) < mu300EndGraceFor(old.State) {
+				next[index] = old
+				continue
+			}
+		}
+		delete(a.mu300GoneSince, old.ID)
+		old.EndedAt, old.UpdatedAt = &now, now
+		old.Missed = old.Direction == "incoming" && (old.State == "incoming" || old.State == "waiting")
+		old.State = "ended"
+		ended = append(ended, old)
+	}
+	if len(ended) > 0 {
+		log.Print("MU300 call: terminal state published")
+	}
+	a.mu300Calls = next
+	// Stable tie breaking, independent of modem response order. Keep the old
+	// single-call wire contract; the additive calls array is for diagnostics.
+	a.calls.Active = nil
+	for _, c := range a.mu300LiveCallsLocked() {
+		if a.calls.Active == nil || callStatePriority(c.State) > callStatePriority(a.calls.Active.State) {
+			copy := c
+			a.calls.Active = &copy
+		}
+	}
+	if len(ended) > 0 {
+		a.calls.History = append(ended, a.calls.History...)
+	}
+	idle := len(next) == 0
+	if idle {
+		a.muted, a.isRecording = false, false
+	}
+	if len(changed)+len(ended) > 0 {
+		a.notifyCallChangedLocked()
+	}
+	a.mu.Unlock()
+	if a.mu300Operations != nil {
+		a.mu300Operations.ended(ended)
+	}
+	for _, c := range ended {
+		if a.push != nil {
+			go func(id string) { _ = a.push.sendCallState(id, "ended") }(c.ID)
+		}
+	}
+	for _, c := range changed {
+		if c.Direction == "incoming" && (c.State == "incoming" || c.State == "waiting") {
+			a.scheduleIncomingPush(c.ID)
+		}
+		if a.push != nil {
+			if phase := lifecyclePhaseForModemState(c.State); phase != "" {
+				go func(id, phase string) { _ = a.push.sendCallState(id, phase) }(c.ID, phase)
+			}
+		}
+		if c.State == "active" {
+			go a.ensureVoiceRouteIfHostEnabled()
+		}
+	}
+	if idle && len(ended) > 0 {
+		go func() {
+			time.Sleep(1500 * time.Millisecond)
+			a.mu.RLock()
+			stillIdle := len(a.mu300Calls) == 0
+			a.mu.RUnlock()
+			if stillIdle {
+				a.stopVoiceRoute()
+			}
+		}()
+	}
+}
+
+func (a *agent) mu300Target(id string) (callRecord, []callRecord, error) {
+	a.mu.RLock()
+	defer a.mu.RUnlock()
+	calls := a.mu300LiveCallsLocked()
+	if len(calls) == 0 {
+		return callRecord{}, calls, errors.New("当前没有通话；来电可能已经结束")
+	}
+	if id == "" {
+		if len(calls) != 1 {
+			return callRecord{}, calls, errors.New("多路通话必须指定 call_id，未执行操作")
+		}
+		return calls[0], calls, nil
+	}
+	for _, c := range calls {
+		if c.ID == id {
+			return c, calls, nil
+		}
+	}
+	return callRecord{}, calls, errors.New("通话 ID 已失效，未操作其他通话")
+}
+
+// Support both standard (0,1,1x,2,2x) and this modem's numeric ranges
+// (0-4,6,7,8,11-17,21-27,71-77). Never infer capability from substrings.
+func mu300SupportsCHLD(response, operation string) bool {
+	want, err := strconv.Atoi(operation)
+	if err != nil {
+		return false
+	}
+	for _, line := range strings.Split(response, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "+CHLD:") {
+			continue
+		}
+		list := strings.TrimSpace(strings.TrimPrefix(line, "+CHLD:"))
+		if !strings.HasPrefix(list, "(") || !strings.HasSuffix(list, ")") {
+			continue
+		}
+		for _, raw := range strings.Split(list[1:len(list)-1], ",") {
+			token := strings.ToLower(strings.TrimSpace(raw))
+			if token == operation {
+				return true
+			}
+			if len(operation) == 2 && operation[1] >= '1' && operation[1] <= '7' && token == operation[:1]+"x" {
+				return true
+			}
+			bounds := strings.Split(token, "-")
+			if len(bounds) == 2 {
+				lo, e1 := strconv.Atoi(bounds[0])
+				hi, e2 := strconv.Atoi(bounds[1])
+				if e1 == nil && e2 == nil && lo <= want && want <= hi {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func mu300ControlCommand(action, digit string, target callRecord, calls []callRecord) (string, error) {
+	switch action {
+	case "answer":
+		if target.State == "active" || target.State == "held" {
+			return "", nil
+		} // repeated answer must never toggle hold
+		if target.State != "incoming" && target.State != "waiting" {
+			return "", errors.New("目标通话当前不可接听")
+		}
+		if len(calls) == 1 {
+			return "ATA", nil
+		}
+		// CHLD=2 is unambiguous only with one waiting call and one active
+		// call. Do not swap held calls or answer another waiting party.
+		if len(calls) == 2 && target.State == "waiting" {
+			for _, c := range calls {
+				if c.ID != target.ID && c.State == "active" {
+					return "AT+CHLD=2", nil
+				}
+			}
+		}
+		return "", errors.New("当前通话组合无法安全接听；仅支持一路通话加一路等待来电")
+	case "reject", "hangup":
+		if action == "reject" && target.State != "incoming" && target.State != "waiting" {
+			return "", errors.New("目标通话已接通，不能作为来电拒接")
+		}
+		if len(calls) == 1 {
+			return "AT+CHUP", nil
+		}
+		if target.State == "waiting" && len(calls) == 2 {
+			for _, c := range calls {
+				if c.ID != target.ID && c.State == "active" {
+					return "AT+CHLD=0", nil
+				}
+			}
+		}
+		if target.State == "active" && target.Index >= 1 && target.Index <= 7 {
+			return "AT+CHLD=1" + strconv.Itoa(target.Index), nil
+		}
+		return "", errors.New("当前通话组合不支持安全定向挂断，未挂断其他通话")
+	case "dtmf":
+		active := 0
+		for _, c := range calls {
+			if c.State == "active" {
+				active++
+			}
+		}
+		if target.State != "active" || active != 1 {
+			return "", errors.New("DTMF 只能发送到唯一已接通的通话")
+		}
+		return `AT+VTS="` + digit + `"`, nil
+	}
+	return "", errors.New("unknown MU300 call action")
+}
+
+// Retaining an identity across a gap must not authorize a modem mutation.
+// Require every retained slot in the fresh snapshot, including peer calls.
+func (a *agent) mu300ControlSnapshot() error {
+	calls, err := a.mu300RefreshCalls()
+	if err != nil {
+		return err
+	}
+	a.mu.RLock()
+	complete := len(calls) == len(a.mu300Calls)
+	a.mu.RUnlock()
+	if !complete {
+		return errors.New("基带通话状态暂未完整确认，请等待刷新后重试；未发送控制命令")
+	}
+	return nil
+}
+
+func (a *agent) mu300Control(action, expectedID, digit string) error {
+	a.mu300CallMu.Lock()
+	defer a.mu300CallMu.Unlock()
+	if err := a.mu300ControlSnapshot(); err != nil {
+		return err
+	}
+	if (action == "hangup" || action == "reject") && a.mu300KnownEndedWhileIdle(expectedID) {
+		return nil
+	}
+	target, calls, err := a.mu300Target(expectedID)
+	if err != nil {
+		return err
+	}
+	for id := range a.mu300Uncertain {
+		if _, _, err := a.mu300Target(id); err != nil {
+			delete(a.mu300Uncertain, id)
+		}
+	}
+	command, err := mu300ControlCommand(action, digit, target, calls)
+	if err != nil || command == "" {
+		if err == nil {
+			delete(a.mu300Uncertain, target.ID)
+		}
+		return err
+	}
+	if command == "AT+CHLD=2" && a.mu300Uncertain[target.ID] {
+		return errors.New("上次接听结果尚未确认，为避免交换通话未重复发送；请等待状态更新")
+	}
+	if strings.HasPrefix(command, "AT+CHLD=") {
+		capabilities, err := a.mu300AT("AT+CHLD=?", 3*time.Second)
+		if err != nil {
+			return fmt.Errorf("无法确认基带呼叫保持能力，未执行操作: %w", err)
+		}
+		if !mu300SupportsCHLD(capabilities, strings.TrimPrefix(command, "AT+CHLD=")) {
+			return errors.New("基带未声明支持该定向通话操作，未执行操作")
+		}
+		// The capability query takes time. Re-read CLCC and bind the action
+		// to the same UUID and topology before any state-changing command.
+		if err = a.mu300ControlSnapshot(); err != nil {
+			return err
+		}
+		fresh, peers, err := a.mu300Target(target.ID)
+		if err != nil {
+			return err
+		}
+		next, err := mu300ControlCommand(action, digit, fresh, peers)
+		if err != nil {
+			return err
+		}
+		if next == "" {
+			return nil
+		}
+		if next != command || !mu300SamePeers(calls, peers) {
+			return errors.New("通话状态已变化，请重新操作；未发送控制命令")
+		}
+	}
+	// Send at most once, even if AT times out. Only a confirmed CLCC result
+	// is success. In particular, never retry CHLD=2 (it would swap calls).
+	_, commandErr := a.mu300AT(command, 5*time.Second)
+	if command == "AT+CHLD=2" {
+		if a.mu300Uncertain == nil {
+			a.mu300Uncertain = make(map[string]bool)
+		}
+		a.mu300Uncertain[target.ID] = true
+	}
+	if action == "dtmf" {
+		return commandErr
+	}
+	for attempt := 0; attempt < 10; attempt++ {
+		if attempt > 0 {
+			if a.callControlSleep != nil {
+				a.callControlSleep(200 * time.Millisecond)
+			} else {
+				time.Sleep(200 * time.Millisecond)
+			}
+		}
+		fresh, err := a.mu300RefreshCalls()
+		if err != nil {
+			continue
+		}
+		observed := false
+		for _, c := range fresh {
+			if c.Index == target.Index {
+				observed = true
+			}
+		}
+		if !observed && commandErr == nil && (action == "hangup" || action == "reject") {
+			a.mu300ApplyCallPollWithEnd(fresh, time.Now(), true, target.ID)
+		}
+		current, _, lookupErr := a.mu300Target(target.ID)
+		if action == "answer" {
+			if observed && lookupErr == nil && current.State == "active" {
+				delete(a.mu300Uncertain, target.ID)
+				return nil
+			}
+			if lookupErr != nil {
+				return errors.New("接听期间目标来电已结束，未接听其他通话")
+			}
+		} else if lookupErr != nil {
+			return nil
+		}
+	}
+	if commandErr != nil {
+		return fmt.Errorf("通话操作结果未确认，请刷新状态，勿重复操作: %w", commandErr)
+	}
+	return errors.New("基带已接受命令，但通话状态尚未确认；请刷新状态，勿重复操作")
+}
+
+func mu300SamePeers(a, b []callRecord) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].ID != b[i].ID || a[i].State != b[i].State {
+			return false
+		}
+	}
+	return true
+}
+
+// A delayed user hangup of an already-confirmed terminal UUID is successful
+// without a modem command. Unknown IDs or any live replacement stay rejected.
+func (a *agent) mu300KnownEndedWhileIdle(id string) bool {
+	if id == "" {
+		return false
+	}
+	a.mu.RLock()
+	defer a.mu.RUnlock()
+	if len(a.mu300Calls) != 0 {
+		return false
+	}
+	for _, c := range a.calls.History {
+		if c.ID == id && c.EndedAt != nil {
+			return true
+		}
+	}
+	return false
+}
diff --git a/module/module-agent/mu300_calls_test.go b/module/module-agent/mu300_calls_test.go
new file mode 100644
index 0000000..e991d36
--- /dev/null
+++ b/module/module-agent/mu300_calls_test.go
@@ -0,0 +1,293 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+const mu300TestActive = "+CLCC: 1,0,0,0,0,\"10010\",129\n"
+const mu300TestWaiting = "+CLCC: 2,1,5,0,0,\"15550001111\",129\n"
+const mu300TestHeld = "+CLCC: 1,0,1,0,0,\"10010\",129\n"
+const mu300TestAnswered = "+CLCC: 2,1,0,0,0,\"15550001111\",129\n"
+const mu300TestCaps = "+CHLD:(0-4,6,7,8,11-17,21-27,71-77)\nOK"
+
+func TestMU300WaitingKeepsBothIDsAndHistory(t *testing.T) {
+	a := testMU300Calls(t, nil)
+	now := time.Now()
+	poll := func(s string) { now = now.Add(time.Second); a.applyCallPoll(parseCLCC(s+"OK"), now) }
+	poll(mu300TestActive)
+	first := a.calls.Active.ID
+	poll(mu300TestActive + mu300TestWaiting)
+	second := a.calls.Active.ID
+	if first == second || a.mu300Calls[1].ID != first {
+		t.Fatal("new caller overwrote first identity")
+	}
+	revision := a.callRevision
+	poll(mu300TestWaiting + mu300TestActive)
+	if a.callRevision != revision {
+		t.Fatal("response reorder created a revision")
+	}
+	poll(mu300TestActive)
+	if a.calls.Active.ID != first {
+		t.Fatal("returning to original call allocated another UUID")
+	}
+	if len(a.calls.History) != 1 || a.calls.History[0].ID != second || !a.calls.History[0].Missed {
+		t.Fatal("waiting call missing from terminal history")
+	}
+	poll(mu300TestActive + mu300TestWaiting)
+	third := a.calls.Active.ID
+	if third == second {
+		t.Fatal("reused modem slot reused a retired UUID")
+	}
+	poll(mu300TestHeld + mu300TestAnswered)
+	if a.calls.Active.ID != third || a.mu300Calls[1].ID != first {
+		t.Fatal("hold/answer changed identities")
+	}
+	snapshot := a.callStatusSnapshot()
+	if len(snapshot.Calls) != 2 || snapshot.Calls[0].ID != first || snapshot.Calls[1].ID != third {
+		t.Fatal("diagnostic calls are incomplete or unsorted")
+	}
+	poll("")
+	if a.calls.Active != nil || len(a.calls.History) != 3 {
+		t.Fatal("not every ended call was retired")
+	}
+}
+
+func TestMU300MissedIdlePollStillRetiresReplacedSlot(t *testing.T) {
+	a := testMU300Calls(t, nil)
+	a.applyCallPoll(parseCLCC(mu300TestAnswered), time.Now())
+	id := a.calls.Active.ID
+	a.applyCallPoll(parseCLCC(mu300TestWaiting), time.Now())
+	if a.calls.Active.ID == id || len(a.calls.History) != 1 || a.calls.History[0].ID != id {
+		t.Fatal("replacement inherited old identity")
+	}
+}
+
+func TestMU300CHLDCapabilityParser(t *testing.T) {
+	for _, tc := range []struct {
+		response, operation string
+		want                bool
+	}{
+		{mu300TestCaps, "2", true}, {mu300TestCaps, "12", true}, {mu300TestCaps, "19", false},
+		{"+CHLD: (0,1,1x,2,2X,3)\nOK", "17", true}, {"+CHLD: (0,1,1x,2,2X,3)\nOK", "22", true},
+		{"+CHLD: (12,21)\nOK", "2", false}, {"+CHLD: (1x)\nOK", "18", false},
+		{"+CHLD: (not-a-range)\nOK", "2", false}, {"OK", "2", false},
+	} {
+		if got := mu300SupportsCHLD(tc.response, tc.operation); got != tc.want {
+			t.Fatalf("%q %s: %v", tc.response, tc.operation, got)
+		}
+	}
+}
+
+func TestMU300WaitingAnswerAndTargetedHangup(t *testing.T) {
+	state := mu300TestActive + mu300TestWaiting + "OK"
+	var writes []string
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		switch cmd {
+		case "AT+CLCC":
+			return state, nil
+		case "AT+CHLD=?":
+			return mu300TestCaps, nil
+		case "AT+CHLD=2":
+			writes = append(writes, cmd)
+			state = mu300TestHeld + mu300TestAnswered + "OK"
+			return "OK", nil
+		case "AT+CHLD=12":
+			writes = append(writes, cmd)
+			state = mu300TestHeld + "OK"
+			return "OK", nil
+		}
+		t.Fatalf("unsafe/unexpected modem write: %s", cmd)
+		return "", nil
+	})
+	_, _ = a.mu300RefreshCalls()
+	first, second := a.mu300Calls[1].ID, a.mu300Calls[2].ID
+	if err := a.answerCallForID(second); err != nil {
+		t.Fatal(err)
+	}
+	if err := a.answerCallForID(second); err != nil {
+		t.Fatal("idempotent answer", err)
+	}
+	if !reflect.DeepEqual(writes, []string{"AT+CHLD=2"}) {
+		t.Fatal("repeated answer swapped held calls", writes)
+	}
+	if a.mu300Calls[1].ID != first || a.mu300Calls[1].State != "held" || a.mu300Calls[2].ID != second {
+		t.Fatal("identity/hold mismatch")
+	}
+	request := httptest.NewRequest("POST", "/api/calls/hangup", strings.NewReader(fmt.Sprintf(`{"call_id":%q}`, second)))
+	response := httptest.NewRecorder()
+	a.hangup(response, request)
+	if response.Code != 200 {
+		t.Fatal(response.Body.String())
+	}
+	if a.calls.Active.ID != first || len(a.mu300Calls) != 1 || len(writes) != 2 {
+		t.Fatal("hangup affected another call", writes)
+	}
+	if err := a.answerCallForID(second); err == nil || len(writes) != 2 {
+		t.Fatal("stale answer reached surviving call")
+	}
+}
+
+func TestMU300RejectWaitingDoesNotHangUpActive(t *testing.T) {
+	state := mu300TestActive + mu300TestWaiting + "OK"
+	writes := 0
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		switch cmd {
+		case "AT+CLCC":
+			return state, nil
+		case "AT+CHLD=?":
+			return mu300TestCaps, nil
+		case "AT+CHLD=0":
+			writes++
+			state = mu300TestActive + "OK"
+			return "OK", nil
+		}
+		t.Fatalf("unexpected write %s", cmd)
+		return "", nil
+	})
+	_, _ = a.mu300RefreshCalls()
+	first, second := a.mu300Calls[1].ID, a.mu300Calls[2].ID
+	if err := a.rejectCallForID(second); err != nil {
+		t.Fatal(err)
+	}
+	if writes != 1 || a.calls.Active.ID != first {
+		t.Fatal("reject damaged active call")
+	}
+	if err := a.rejectCallForID(first); err == nil || writes != 1 {
+		t.Fatal("reject terminated connected call")
+	}
+}
+
+func TestMU300MultiCallGuardsAndCapabilityRace(t *testing.T) {
+	for _, mode := range []string{"missing-id", "stale-id", "unsupported", "capability-failure", "caller-ended", "peer-replaced", "extra-held"} {
+		t.Run(mode, func(t *testing.T) {
+			state := mu300TestActive + mu300TestWaiting + "OK"
+			if mode == "extra-held" {
+				state = mu300TestActive + mu300TestWaiting + "+CLCC: 3,0,1,0,0\nOK"
+			}
+			a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+				if cmd == "AT+CLCC" {
+					return state, nil
+				}
+				if cmd == "AT+CHLD=?" {
+					switch mode {
+					case "unsupported":
+						return "+CHLD: (0,1)\nOK", nil
+					case "capability-failure":
+						return "", errors.New("timeout")
+					case "caller-ended":
+						state = mu300TestActive + "OK"
+					case "peer-replaced":
+						state = strings.Replace(mu300TestActive, "1,0,0", "1,1,0", 1) + mu300TestWaiting + "OK"
+					}
+					return mu300TestCaps, nil
+				}
+				t.Fatalf("guard allowed mutation %s", cmd)
+				return "", nil
+			})
+			_, _ = a.mu300RefreshCalls()
+			id := a.mu300Calls[2].ID
+			if mode == "missing-id" {
+				id = ""
+			}
+			if mode == "stale-id" {
+				id = "mu300-retired"
+			}
+			if err := a.answerCallForID(id); err == nil {
+				t.Fatal("guard did not reject")
+			}
+		})
+	}
+}
+
+func TestMU300AnswerConfirmationAndNoToggleRetry(t *testing.T) {
+	for _, mode := range []string{"delayed", "timeout-but-applied", "accepted-not-applied", "caller-ended"} {
+		t.Run(mode, func(t *testing.T) {
+			state := mu300TestActive + mu300TestWaiting + "OK"
+			writes, polls := 0, 0
+			a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+				switch cmd {
+				case "AT+CHLD=?":
+					return mu300TestCaps, nil
+				case "AT+CLCC":
+					if writes > 0 {
+						polls++
+						if mode == "delayed" && polls == 3 {
+							state = mu300TestHeld + mu300TestAnswered + "OK"
+						}
+					}
+					return state, nil
+				case "AT+CHLD=2":
+					writes++
+					if mode == "timeout-but-applied" {
+						state = mu300TestHeld + mu300TestAnswered + "OK"
+						return "", errors.New("timeout")
+					}
+					if mode == "caller-ended" {
+						state = mu300TestActive + "OK"
+					}
+					return "OK", nil
+				}
+				t.Fatalf("unexpected %s", cmd)
+				return "", nil
+			})
+			_, _ = a.mu300RefreshCalls()
+			err := a.answerCallForID(a.mu300Calls[2].ID)
+			wantSuccess := mode == "delayed" || mode == "timeout-but-applied"
+			if (err == nil) != wantSuccess || writes != 1 {
+				t.Fatalf("success=%v writes=%d err=%v", wantSuccess, writes, err)
+			}
+			if mode == "accepted-not-applied" {
+				if err := a.answerCallForID(a.mu300Calls[2].ID); err == nil || writes != 1 {
+					t.Fatal("uncertain hold command was repeated")
+				}
+			}
+		})
+	}
+}
+
+func TestMU300CloudActionRetainsIDGuard(t *testing.T) {
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		if cmd == "AT+CLCC" {
+			return mu300TestActive + mu300TestWaiting + "OK", nil
+		}
+		t.Fatalf("stale cloud action mutated call: %s", cmd)
+		return "", nil
+	})
+	_, _ = a.mu300RefreshCalls()
+	for _, action := range []string{"answer", "reject", "end"} {
+		if err := a.executeIncomingCloudCallAction(cloudCallAction{CallID: "old-call"}, action); err == nil {
+			t.Fatal("stale cloud control accepted", action)
+		}
+	}
+	if !a.cloudCallStillExists(a.mu300Calls[1].ID) {
+		t.Fatal("unselected original call was treated as ended")
+	}
+}
+
+func TestMU300MalformedCLCCPreservesIdentity(t *testing.T) {
+	state := mu300TestActive + "OK"
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		if cmd == "AT+CLCC" {
+			return state, nil
+		}
+		t.Fatalf("unexpected mutation %s", cmd)
+		return "", nil
+	})
+	_, _ = a.mu300RefreshCalls()
+	id := a.calls.Active.ID
+	for _, invalid := range []string{"+CLCC: broken\nOK", mu300TestActive + mu300TestActive + "OK", "+CLCC: 1,0,99,0,0\nOK"} {
+		state = invalid
+		if _, err := a.mu300RefreshCalls(); err == nil || a.calls.Active.ID != id {
+			t.Fatal("invalid snapshot reset identity")
+		}
+		if err := a.hangupCallForID(id); err == nil {
+			t.Fatal("invalid snapshot allowed control")
+		}
+	}
+}
diff --git a/module/module-agent/mu300_cloud_early_media.go b/module/module-agent/mu300_cloud_early_media.go
new file mode 100644
index 0000000..39ff933
--- /dev/null
+++ b/module/module-agent/mu300_cloud_early_media.go
@@ -0,0 +1,202 @@
+package main
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Relay call IDs are not modem UUIDs. Only the persisted successful dial
+// receipt may bind the two; never adopt whatever outgoing call happens to exist.
+func (a *agent) mu300CloudCallState(d cloudCallDescriptor) string {
+	current, ok := a.currentCloudCallDescriptor()
+	if !ok || d.Direction != "outgoing" || d.LocalCallID == "" ||
+		current.Direction != "outgoing" || current.CallID != d.CallID || current.LocalCallID != d.LocalCallID ||
+		current.CallUUID != d.CallUUID || current.Generation != d.Generation {
+		return ""
+	}
+	a.mu.RLock()
+	defer a.mu.RUnlock()
+	for _, c := range a.mu300Calls {
+		if c.ID == d.LocalCallID && c.Direction == "outgoing" {
+			return c.State
+		}
+	}
+	return ""
+}
+
+func (a *agent) mu300CloudEarlyMediaStatus(w http.ResponseWriter, r *http.Request) {
+	if !requireMethod(w, r, http.MethodGet) {
+		return
+	}
+	if a.profile.Name != "mu300-openwrt" || a.mu300Operations == nil {
+		writeError(w, 501, "unavailable")
+		return
+	}
+	q, err := url.ParseQuery(r.URL.RawQuery)
+	gen, ge := strconv.ParseUint(q.Get("generation"), 10, 64)
+	if err != nil || len(q) != 3 || len(q["call_id"]) != 1 || len(q["call_uuid"]) != 1 || len(q["generation"]) != 1 || !mu300ValidIdentity(q.Get("call_id")) || !mu300ValidIdentity(q.Get("call_uuid")) || ge != nil || gen == 0 || strconv.FormatUint(gen, 10) != q.Get("generation") {
+		writeError(w, 400, "identity")
+		return
+	}
+	d, ok := a.currentCloudCallDescriptor()
+	if !ok || d.Direction != "outgoing" || d.CallID != q.Get("call_id") || d.CallUUID != q.Get("call_uuid") || d.Generation != gen || a.mu300CloudCallState(d) == "" {
+		writeError(w, 410, "call ended or replaced")
+		return
+	}
+	if !a.mu300Operations.ownsEarlyCall("relay", d.LocalCallID) {
+		writeError(w, 403, "unowned call")
+		return
+	}
+	code := a.mu300CloudEarlyCode(d)
+	if code != 200 {
+		writeError(w, code, http.StatusText(code))
+		return
+	}
+	writeJSON(w, 200, map[string]any{"call_id": d.CallID, "native_early_media": true})
+}
+
+func cloudEarlyQuery(d cloudCallDescriptor) url.Values {
+	return url.Values{"call_id": {d.CallID}, "call_uuid": {d.CallUUID}, "generation": {strconv.FormatUint(d.Generation, 10)}}
+}
+
+func (a *agent) startMU300OutgoingCloudPCM(ctx context.Context, socket *cloudWebSocket, bridge *cloudPCMBridge, d cloudCallDescriptor, health *cloudMediaHealthTracker, earlyMediaNegotiated bool) {
+	client := &http.Client{Transport: &http.Transport{Proxy: nil, ResponseHeaderTimeout: 10 * time.Second}, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	defer client.CloseIdleConnections()
+	a.waitMU300OutgoingCloudPCM(ctx, socket, bridge, d, health, earlyMediaNegotiated, client)
+}
+
+func (a *agent) waitMU300OutgoingCloudPCM(ctx context.Context, socket *cloudWebSocket, bridge *cloudPCMBridge, d cloudCallDescriptor, health *cloudMediaHealthTracker, earlyMediaNegotiated bool, client *http.Client) {
+	// Only the pre-connect phase is bounded here; duplex has its own lifecycle.
+	earlyCtx, cancel := context.WithTimeout(ctx, 3*time.Minute)
+	defer cancel()
+	attempted := false
+	for earlyCtx.Err() == nil {
+		state := a.mu300CloudCallState(d)
+		if state == "" {
+			return
+		}
+		if (state == "active" || state == "held") && a.mu300CloudDuplexReady(d) {
+			a.voice.mu.Lock()
+			a.voice.hostEnabled = true
+			a.voice.mu.Unlock()
+			a.connectCloudPCM(ctx, socket, bridge, d, health)
+			return
+		}
+		if earlyMediaNegotiated && !attempted && a.mu300CloudEarlyCode(d) == 200 {
+			attempted = true
+			a.forwardMU300CloudEarly(earlyCtx, client, socket, bridge, d)
+		}
+		if !waitCloudRetry(earlyCtx, 250*time.Millisecond) {
+			return
+		}
+	}
+}
+
+func (a *agent) forwardMU300CloudEarly(ctx context.Context, client *http.Client, socket *cloudWebSocket, bridge *cloudPCMBridge, d cloudCallDescriptor) {
+	streamCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	defer func() {
+		// Failure only ends receive-only playback. Do not send a late fallback
+		// notification after real ACTIVE, terminal state, or descriptor replacement.
+		state := a.mu300CloudCallState(d)
+		if ctx.Err() == nil && (state == "dialing" || state == "alerting") {
+			_ = socket.WriteText(cloudStatusForAction("early_media_unavailable", "", d, cloudCallAction{}))
+		}
+	}()
+	req, err := http.NewRequestWithContext(streamCtx, "GET", "http://127.0.0.1:7581/internal/cloud-early-media?"+cloudEarlyQuery(d).Encode(), nil)
+	if err != nil {
+		return
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != 200 || !strings.HasPrefix(resp.Header.Get("Content-Type"), "application/octet-stream") {
+		return
+	}
+	// Unlike normal PCM, never attach this reader to bridge.conn. All client
+	// microphone frames are discarded until duplex explicitly installs a socket.
+	watchDone := make(chan struct{})
+	go func() {
+		defer close(watchDone)
+		tick := time.NewTicker(100 * time.Millisecond)
+		defer tick.Stop()
+		for {
+			select {
+			case <-streamCtx.Done():
+				return
+			case <-tick.C:
+				if a.mu300CloudEarlyCode(d) != 200 {
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	defer func() { cancel(); <-watchDone }()
+	stall := time.AfterFunc(3*time.Second, cancel)
+	defer stall.Stop()
+	reported := false
+	frame := make([]byte, cloudPCMFrameBytes)
+	for {
+		if _, err = io.ReadFull(resp.Body, frame); err != nil {
+			return
+		}
+		if streamCtx.Err() != nil || a.mu300CloudEarlyCode(d) != 200 {
+			return
+		}
+		if !reported {
+			if err = socket.WriteText(cloudStatusForAction("early_media_ready_v1", "", d, cloudCallAction{})); err != nil {
+				return
+			}
+			reported = true
+		}
+		if err = socket.WriteBinary(bridge.frameDownlink(frame, time.Now())); err != nil {
+			return
+		}
+		stall.Reset(3 * time.Second)
+	}
+}
+
+// MU300 CLCC dialing/alerting both represent the client's unconnected DIALING
+// phase. Never authorize a global capture tap while another call coexists.
+func (a *agent) mu300CloudEarlyCode(d cloudCallDescriptor) int {
+	if a.mu300CloudCallState(d) == "" {
+		return 410
+	}
+	a.mu.RLock()
+	exclusive := len(a.mu300Calls) == 1
+	a.mu.RUnlock()
+	if !exclusive {
+		return 410
+	}
+	return a.mu300EarlySignalCode(d.LocalCallID)
+}
+
+func (a *agent) mu300CloudDuplexReady(d cloudCallDescriptor) bool {
+	id := d.CallID
+	if d.Direction == "outgoing" {
+		if a.mu300CloudCallState(d) == "" {
+			return false
+		}
+		id = d.LocalCallID
+	}
+	a.mu.RLock()
+	defer a.mu.RUnlock()
+	age := time.Since(a.mu300EarlyPollAt)
+	if a.mu300EarlyPollAt.IsZero() || age < 0 || age > 2500*time.Millisecond {
+		return false
+	}
+	for _, c := range a.mu300Calls {
+		if c.ID == id && (c.State == "active" || c.State == "held") {
+			return true
+		}
+	}
+	return false
+}
