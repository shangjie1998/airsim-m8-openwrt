+
+func TestMU300CloudPCMReadyDoesNotFakeAnswer(t *testing.T) {
+	a, d := cloudEarlyAgentFixture(t)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	a.voiceBackend.endpoint = listener.Addr().String()
+	// The fake PCM backend incorrectly offers READY even while the modem is
+	// no longer connected. The Agent must recheck before claiming ACTIVE.
+	handshakes := make(chan struct{}, 2)
+	backendDone := make(chan struct{})
+	go func() {
+		defer close(backendDone)
+		for i := 0; i < 2; i++ {
+			conn, e := listener.Accept()
+			if e != nil {
+				return
+			}
+			conn.SetDeadline(time.Now().Add(3 * time.Second))
+			hello := make([]byte, len("AIRSIMPCM1\n"))
+			_, e = io.ReadFull(conn, hello)
+			if e == nil && string(hello) == "AIRSIMPCM1\n" {
+				if i == 0 {
+					a.mu.Lock()
+					call := a.mu300Calls[1]
+					call.State = "alerting"
+					a.mu300Calls[1] = call
+					a.mu.Unlock()
+				}
+				io.WriteString(conn, "AIRSIMREADY")
+				handshakes <- struct{}{}
+				conn.Write([]byte(strings.Repeat("z", 320)))
+				io.Copy(io.Discard, conn)
+			}
+			conn.Close()
+		}
+	}()
+	for _, active := range []bool{false, true} {
+		{
+			a.mu.Lock()
+			call := a.mu300Calls[1]
+			call.State = "active"
+			a.mu300Calls[1] = call
+			a.mu300EarlyPollAt = time.Now()
+			a.mu.Unlock()
+		}
+		s, c := net.Pipe()
+		socket := &cloudWebSocket{conn: s, reader: bufio.NewReader(s)}
+		peer := &cloudWebSocket{conn: c, reader: bufio.NewReader(c)}
+		ctx, cancel := context.WithCancel(context.Background())
+		health := newCloudMediaHealthTracker(time.Now(), d)
+		bridge := &cloudPCMBridge{health: health}
+		done := make(chan struct{})
+		go func() { a.connectCloudPCM(ctx, socket, bridge, d, health); close(done) }()
+		c.SetReadDeadline(time.Now().Add(2 * time.Second))
+		op, payload, e := peer.ReadMessage()
+		if e != nil || op != cloudOpcodeText || !strings.Contains(string(payload), "pcm_listening") {
+			t.Fatal("no listening milestone", e)
+		}
+		select {
+		case <-handshakes:
+		case <-time.After(time.Second):
+			t.Fatal("no PCM handshake")
+		}
+		if !active {
+			c.SetReadDeadline(time.Now().Add(80 * time.Millisecond))
+			_, _, e = peer.ReadMessage()
+			if e == nil {
+				t.Fatal("READY produced active before modem answered")
+			}
+		} else {
+			op, payload, e = peer.ReadMessage()
+			if e != nil || op != cloudOpcodeText || !strings.Contains(string(payload), `"status":"active"`) {
+				t.Fatal("real ACTIVE not reported", e, string(payload))
+			}
+			op, payload, e = peer.ReadMessage()
+			if e != nil || op != cloudOpcodeText || !strings.Contains(string(payload), "pcm_ready") {
+				t.Fatal("no ready", e)
+			}
+			op, payload, e = peer.ReadMessage()
+			if e != nil || op != cloudOpcodeBinary || string(payload) != strings.Repeat("z", 320) {
+				t.Fatal("no connected PCM", e)
+			}
+		}
+		cancel()
+		bridge.close()
+		s.Close()
+		c.Close()
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+			t.Fatal("PCM session leaked")
+		}
+	}
+	select {
+	case <-backendDone:
+	case <-time.After(time.Second):
+		t.Fatal("backend leaked")
+	}
+}
+
+func TestMU300LegacyCloudDoesNotOpenEarlySource(t *testing.T) {
+	a, d := cloudEarlyAgentFixture(t)
+	var opened atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { opened.Add(1); w.WriteHeader(503) }))
+	defer server.Close()
+	transport := &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", server.Listener.Addr().String())
+	}}
+	defer transport.CloseIdleConnections()
+	s, c := net.Pipe()
+	defer s.Close()
+	defer c.Close()
+	// No peer consumes status or PCM: without an offer this path must remain
+	// entirely silent, even though owned native early media is already available.
+	ctx, cancel := context.WithTimeout(context.Background(), 75*time.Millisecond)
+	defer cancel()
+	a.waitMU300OutgoingCloudPCM(ctx, &cloudWebSocket{conn: s, reader: bufio.NewReader(s)}, &cloudPCMBridge{}, d, nil, false, &http.Client{Transport: transport})
+	if opened.Load() != 0 {
+		t.Fatal("legacy client opened receive-only capture")
+	}
+	if a.mu300CloudCallState(d) != "alerting" {
+		t.Fatal("legacy fallback changed call")
+	}
+}
diff --git a/module/module-agent/mu300_early_media.go b/module/module-agent/mu300_early_media.go
new file mode 100644
index 0000000..871fe76
--- /dev/null
+++ b/module/module-agent/mu300_early_media.go
@@ -0,0 +1,83 @@
+package main
+
+import (
+	"net/http"
+	"net/url"
+	"time"
+)
+
+// Existing journals without an owner digest remain valid for deduplication, but
+// cannot authorize media. Never infer ownership from a number, slot or history.
+func (s *mu300OperationStore) ownsEarlyCall(owner, call string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.load() != nil {
+		return false
+	}
+	digest := mu300DialHash(owner)
+	for _, r := range s.journal.Records {
+		if r.Status == "confirmed" && r.CallID == call && r.OwnerDigest == digest {
+			return true
+		}
+	}
+	return false
+}
+
+// Loopback-only signaling evidence. The authenticated gateway separately gates
+// physical source verification and issues the signed lease. This endpoint never
+// opens audio, sends AT, changes call state, or claims a verified audio source.
+func (a *agent) mu300EarlyMediaStatus(w http.ResponseWriter, r *http.Request) {
+	if !requireMethod(w, r, http.MethodGet) {
+		return
+	}
+	if a.profile.Name != "mu300-openwrt" || a.mu300Operations == nil {
+		writeError(w, 501, "早期媒体信令不可用")
+		return
+	}
+	query, err := parseEarlyQuery(r)
+	owner, ownerErr := mu300RequestOwner(r)
+	if err || ownerErr != nil || owner == "local" {
+		writeError(w, 403, "早期媒体身份无效")
+		return
+	}
+	if !a.mu300Operations.ownsEarlyCall(owner, query) {
+		writeError(w, 403, "此身份未持有该通话")
+		return
+	}
+	code := a.mu300EarlySignalCode(query)
+	if code != 200 {
+		writeError(w, code, http.StatusText(code))
+		return
+	}
+	writeJSON(w, 200, map[string]any{"call_id": query, "native_early_media": true})
+}
+
+// No I/O or state mutation: native signal and a fresh, single outgoing snapshot
+// are required independently from authentication and the capture adapter.
+func (a *agent) mu300EarlySignalCode(id string) int {
+	a.mu.RLock()
+	defer a.mu.RUnlock()
+	age := time.Since(a.mu300EarlyPollAt)
+	if a.mu300EarlyFreshCall != id || a.mu300EarlyPollAt.IsZero() || age < 0 || age > 2500*time.Millisecond {
+		return 410
+	}
+	live := false
+	for _, c := range a.mu300Calls {
+		if c.ID == id && c.Direction == "outgoing" && (c.State == "dialing" || c.State == "alerting") {
+			live = true
+		}
+	}
+	if !live {
+		return 410
+	}
+	if a.mu300EarlyCall != id {
+		return 202
+	}
+	return 200
+}
+
+func parseEarlyQuery(r *http.Request) (string, bool) {
+	q, err := url.ParseQuery(r.URL.RawQuery)
+	id := q.Get("call_id")
+	return id, err != nil || len(q) != 1 || len(q["call_id"]) != 1 || !mu300ValidIdentity(id)
+}
diff --git a/module/module-agent/mu300_early_media_test.go b/module/module-agent/mu300_early_media_test.go
