--- /dev/null
+++ b/module/module-agent/mu300_redial.go
@@ -0,0 +1,14 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+)
+
+// Operation journals store digests instead of raw dial parameters or owners.
+// There is no per-number redial cooldown. Old dial.json is left untouched for
+// backup/rollback; execution deduplication uses operations.json instead.
+func mu300DialHash(value string) string {
+	digest := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(digest[:])
+}
diff --git a/module/module-agent/mu300_redial_test.go b/module/module-agent/mu300_redial_test.go
new file mode 100644
index 0000000..22b9f57
--- /dev/null
+++ b/module/module-agent/mu300_redial_test.go
@@ -0,0 +1,121 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func redialFixture(t *testing.T) (*agent, *string, *int) {
+	state, writes := "OK", 0
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		if cmd == "AT+CLCC" {
+			return state, nil
+		}
+		if strings.HasPrefix(cmd, "ATD") {
+			writes++
+			state = `+CLCC: 1,0,3,0,0,"12345",129` + "\nOK"
+			return "OK", nil
+		}
+		return "", fmt.Errorf("unexpected control command")
+	})
+	return a, &state, &writes
+}
+func TestMU300ConfirmedEndAllowsImmediateManualRedialButNeverReplays(t *testing.T) {
+	a, state, writes := redialFixture(t)
+	first, e := a.mu300Dial("12345", "first-click", "")
+	if e != nil {
+		t.Fatal(e)
+	}
+	*state = "OK"
+	a.mu300ApplyCallPoll(nil, time.Now(), false)
+	old, e := a.mu300Dial("12345", "first-click", "")
+	if e != nil || old["state"] != "ended" || *writes != 1 {
+		t.Fatal("old intent repeated ATD", e)
+	}
+	next, e := a.mu300Dial("12345", "second-click", "")
+	if e != nil || *writes != 2 || next["backend_id"] == first["backend_id"] {
+		t.Fatal("new manual dial blocked or reused old call", e)
+	}
+	a.mu300Dial("12345", "first-click", "")
+	if *writes != 2 || a.calls.Active.ID != next["backend_id"] {
+		t.Fatal("old retry altered replacement")
+	}
+}
+func TestMU300OldQuietUntilDoesNotBlockNewIntent(t *testing.T) {
+	a, _, writes := redialFixture(t)
+	old := []byte(`{"version":1,"number_digest":"fixture","pending":false,"quiet_until":"2099-01-01T00:00:00Z"}`)
+	path := filepath.Join(a.mu300Operations.directory, "dial.json")
+	if e := os.WriteFile(path, old, 0600); e != nil {
+		t.Fatal(e)
+	}
+	if _, e := a.mu300Dial("12345", "new-click", ""); e != nil || *writes != 1 {
+		t.Fatal("legacy time lock still enforced", e)
+	}
+	unchanged, _ := os.ReadFile(path)
+	if string(unchanged) != string(old) {
+		t.Fatal("legacy rollback record modified")
+	}
+}
+func TestMU300MissingIntentCannotBypassPersistentDeduplication(t *testing.T) {
+	a, _, writes := redialFixture(t)
+	if _, e := a.mu300Dial("12345", "", ""); e == nil || *writes != 0 {
+		t.Fatal("unidentified non-idempotent dial accepted")
+	}
+}
+func TestMU300SameIntentUnknownOutcomeNeverRepeatsATD(t *testing.T) {
+	writes := 0
+	a := testMU300Calls(t, func(cmd string, _ time.Duration) (string, error) {
+		if cmd == "AT+CLCC" {
+			return "OK", nil
+		}
+		writes++
+		return "", fmt.Errorf("reply lost")
+	})
+	for i := 0; i < 3; i++ {
+		if _, e := a.mu300Dial("12345", "same-click", ""); e == nil {
+			t.Fatal("unknown outcome accepted")
+		}
+	}
+	if writes != 1 {
+		t.Fatal("unknown operation repeated", writes)
+	}
+}
+func TestMU300ConcurrentFreshRequestsStillRespectLiveCall(t *testing.T) {
+	a, _, writes := redialFixture(t)
+	var wg sync.WaitGroup
+	for i := 0; i < 12; i++ {
+		wg.Add(1)
+		go func(i int) { defer wg.Done(); a.mu300Dial("12345", fmt.Sprint(i), "") }(i)
+	}
+	wg.Wait()
+	if *writes != 1 {
+		t.Fatal("concurrent calls emitted multiple ATD", *writes)
+	}
+}
+func TestMU300HTTPNewClickImmediatelyAfterEnd(t *testing.T) {
+	a, state, writes := redialFixture(t)
+	call := func(op string) *httptest.ResponseRecorder {
+		body, _ := json.Marshal(map[string]string{"number": "12345", "operation_id": op})
+		w := httptest.NewRecorder()
+		a.dial(w, httptest.NewRequest("POST", "/api/calls/dial", strings.NewReader(string(body))))
+		return w
+	}
+	if w := call("first"); w.Code != 200 {
+		t.Fatal(w.Code)
+	}
+	*state = "OK"
+	a.mu300ApplyCallPoll(nil, time.Now(), false)
+	if w := call("second"); w.Code != 200 || *writes != 2 {
+		t.Fatal("HTTP redial still has cooldown", w.Code)
+	}
+	if w := call("second"); w.Code != 200 || *writes != 2 {
+		t.Fatal("HTTP intent replay redialed", w.Code)
+	}
+}
diff --git a/module/module-agent/mu300_resolve.go b/module/module-agent/mu300_resolve.go
new file mode 100644
index 0000000..59971e5
--- /dev/null
+++ b/module/module-agent/mu300_resolve.go
@@ -0,0 +1,91 @@
+package main
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"regexp"
+	"strconv"
+)
+
+var mu300PushUUID = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+
+// MU300 already publishes its stable local UUID as the push call_id. Only the
+// independently generated call_uuid and generation need to be bound to it.
+// Never recover missing push state from a number, timestamp or modem slot.
+func (a *agent) mu300ResolvePushedCall(w http.ResponseWriter, r *http.Request) {
+	if !requireMethod(w, r, http.MethodPost) {
+		return
+	}
+	if a.profile.Name != "mu300-openwrt" {
+		http.NotFound(w, r)
+		return
+	}
+	var body struct {
+		CallID     string          `json:"call_id"`
+		CallUUID   string          `json:"call_uuid"`
+		Generation json.RawMessage `json:"generation"`
+	}
+	decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4096))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&body); err != nil {
+		writeError(w, 400, "invalid call identity request")
+		return
+	}
+	var extra any
+	if decoder.Decode(&extra) != io.EOF {
+		writeError(w, 400, "invalid call identity request")
+		return
+	}
+	generationText := string(body.Generation)
+	if len(body.Generation) > 0 && body.Generation[0] == '"' {
+		if err := json.Unmarshal(body.Generation, &generationText); err != nil {
+			writeError(w, 409, "invalid call identity tuple")
+			return
+		}
+	}
+	// Match the Android gateway's positive signed-64-bit range. Never use a
+	// float decoder (which could round generations), or a legacy default of 1.
+	generation, err := strconv.ParseUint(generationText, 10, 63)
+	if err != nil || generation == 0 ||
+		!mu300ValidIdentity(body.CallID) || !mu300PushUUID.MatchString(body.CallUUID) {
+		writeError(w, 409, "invalid call identity tuple")
+		return
+	}
+	matches := func() bool {
+		if a.push == nil {
+			return false
+		}
+		a.push.mu.Lock()
+		defer a.push.mu.Unlock()
+		return a.push.lastCallID == body.CallID && a.push.lastUUID == body.CallUUID &&
+			a.push.lastGeneration == generation
+	}
+	if !matches() {
+		writeError(w, 409, "push call identity is stale")
+		return
+	}
+	a.mu300CallMu.Lock()
+	defer a.mu300CallMu.Unlock()
+	// A retained call during a missing/failed CLCC poll cannot authorize resolution.
+	if err := a.mu300ControlSnapshot(); err != nil {
+		writeError(w, 409, "live call cannot be confirmed")
+		return
+	}
+	snapshot := a.callStatusSnapshot()
+	if !matches() {
+		writeError(w, 409, "push call identity is stale")
+		return
+	}
+	for _, call := range snapshot.Calls {
+		if call.ID == body.CallID && call.AndroidID == body.CallID && call.EndedAt == nil &&
+			call.Direction == "incoming" && (call.State == "incoming" || call.State == "waiting" || call.State == "active" || call.State == "held") {
+			// Project the verified real target, even if another call has priority in the
+			// default status view. Do not alter the tracker, audio route or modem state.
+			snapshot.Active = &call
+			writeJSON(w, 200, snapshot)
+			return
+		}
+	}
+	writeError(w, 409, "push call is no longer live")
+}
diff --git a/module/module-agent/mu300_resolve_test.go b/module/module-agent/mu300_resolve_test.go
