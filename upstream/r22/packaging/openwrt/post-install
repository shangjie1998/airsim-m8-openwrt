#!/bin/sh
# rpcd must rescan the new executable and ACL before LuCI can call it.
/etc/init.d/airsim-update enable >/dev/null 2>&1
(/etc/init.d/airsim-update restart >/dev/null 2>&1) &
(/etc/init.d/rpcd restart >/dev/null 2>&1) &
if [ "$(uci -q get airsim.main.enabled)" = 1 ]; then
	(/etc/init.d/airsim start >/tmp/airsim-start.log 2>&1) &
fi
exit 0
