#!/bin/sh /etc/rc.common
START=98
STOP=9
USE_PROCD=1

start_service() {
	. /lib/functions.sh
	config_load airsim
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get interface main interface br-lan
	case "$interface" in *[!a-zA-Z0-9_.-]*|'') return 1 ;; esac
	/usr/lib/airsim/prepare || return 1
	procd_open_instance agent
	procd_set_param command /usr/lib/airsim/airsim-mu300d --run-agent
	procd_set_param term_timeout 30
	procd_set_param env AIRSIM_RUNTIME_PROFILE=mu300-openwrt AIRSIM_VOICE_BACKEND=mu300 AIRSIM_DATA_DIR=/mnt/mu300-disk/extra/airsim/data PATH=/usr/lib/airsim/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/bin:/opt/mu300/busybox-bin
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance bridge
	# A saved management configuration owns the interface; preserve legacy UCI
	# installations until their first explicit settings save.
	if [ -f /mnt/mu300-disk/extra/airsim/data/management.json ]; then
		procd_set_param command /usr/lib/airsim/airsim-mu300d
	else
		procd_set_param command /usr/lib/airsim/airsim-mu300d --interface "$interface"
	fi
	procd_set_param term_timeout 25
	procd_set_param env PATH=/usr/lib/airsim/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/bin:/opt/mu300/busybox-bin
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger airsim
}
